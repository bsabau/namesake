# Namesake's site block. On the demo host it is sites/namesake.caddy in the host-proxy
# repository (decision 42); elsewhere, add it to the proxy's config. Caddy gets and renews
# the certificate itself.
namesake.bogdansabau.eu {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	header -Server
	reverse_proxy namesake:8000
}
