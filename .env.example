# Copy to .env and fill in. Never commit .env.

# Qloo harness. Not needed on a dev machine where ~/.qloo/config is set up.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com

# The agent's model (OpenAI-compatible endpoint).
AGENT_BASE_URL=
AGENT_API_KEY=
AGENT_MODEL=
# "responses" or "chat"
AGENT_API=chat
# Structured output: "native", "prompted" or "tool" (some models allow only native/prompted)
AGENT_OUTPUT_MODE=native

# Seconds between live Qloo calls (the hackathon key is rate-limited)
QLOO_MIN_INTERVAL=5
# Whether web runs may call Qloo live (false: cache and recordings only)
ALLOW_LIVE_QLOO=true
