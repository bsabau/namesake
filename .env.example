# Copy to .env and fill in. Never commit .env.

# Qloo harness. Not needed on a dev machine where ~/.qloo/config is set up.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com

# The agent's model (OpenAI-compatible endpoint).
AGENT_BASE_URL=
AGENT_API_KEY=
AGENT_MODEL=
# "responses" or "chat"
AGENT_API=chat
