# Copy to .env and fill in. Never commit .env.

# Qloo harness. Not needed on a dev machine where ~/.qloo/config is set up.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com

# The agent's model (OpenAI-compatible endpoint).
AGENT_BASE_URL=
AGENT_API_KEY=
AGENT_MODEL=
# "responses" or "chat"
AGENT_API=chat
# Structured output: "native", "prompted" or "tool" (some models allow only native/prompted)
AGENT_OUTPUT_MODE=native

# Seconds between live Qloo calls (the hackathon key is rate-limited)
QLOO_MIN_INTERVAL=5
# Whether web runs may call Qloo live (false: cache and recordings only)
ALLOW_LIVE_QLOO=true

# Limits on live work (saved results are free). Per visitor is per hour; caps are per UTC day.
LIVE_RUNS_PER_VISITOR_PER_HOUR=6
LIVE_RUNS_PER_DAY=60
NEW_LOCATIONS_PER_DAY=10
# Behind a reverse proxy, set to the proxy's address so per-visitor limits see real clients.
FORWARDED_ALLOW_IPS=127.0.0.1
# Area names for the location field and the map pick (Photon, OpenStreetMap data).
# Must be https://; empty turns suggestions and the map pick off (typing still works).
GEOCODER_URL=https://photon.komoot.io
